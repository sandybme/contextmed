# ContextMed Environment Variables
# Copy to .env and fill in your values

# HuggingFace token — required to download MedGemma weights
HF_TOKEN=hf_your_token_here

# Tavily API key — for clinical guideline web search
TAVILY_API_KEY=tvly-your_key_here

# Ngrok token — to expose FastAPI from Kaggle (optional locally)
NGROK_TOKEN=your_ngrok_token_here

# Model configuration
MODEL_ID=google/medgemma-4b-it
QUANTIZE_4BIT=true
MAX_GENERATION_TOKENS=1024
